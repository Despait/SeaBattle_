digraph G {graph [rankdir=TB,bgcolor="white",nodesep=.25];node [shape=record,fontname="DejaVu Sans",fontsize=10];edge [fontname="DejaVu Sans",fontsize=9]; Player [label="{Player (abstract)|+ name\l+ board\l|+ choose_shot()} "]; Admiral; TacticalAI [label="{TacticalAI|+ level\l+ hits\l|+ choose_shot()\l+ observe()}"]; Weapon [label="{Weapon (abstract)|+ name|+ cells()\l+ attack()}"]; Cannon; Torpedo; Airstrike; Board [label="{Board|- ships\l- shots\l|+ fire()\l+ available()\l+ render()}"]; Ship [label="{Ship|- cells\l- hits\l|+ hit()\l+ sunk}"]; Battle [label="{Battle|- ammo\l+ winner\l|+ play()}"]; NavalUI [label="{NavalUI|+ draw()\l+ click()\l+ reset()}"]; Admiral -> Player [arrowhead=empty]; TacticalAI -> Player [arrowhead=empty]; Cannon -> Weapon [arrowhead=empty]; Torpedo -> Weapon [arrowhead=empty]; Airstrike -> Weapon [arrowhead=empty]; NavalUI -> Battle [dir=back,arrowtail=diamond]; Battle -> Admiral [dir=back,arrowtail=diamond]; Battle -> TacticalAI [dir=back,arrowtail=diamond]; Battle -> Weapon [dir=back,arrowtail=diamond,label="3"]; Player -> Board [dir=back,arrowtail=diamond]; Board -> Ship [dir=back,arrowtail=diamond,label="10"]; Weapon -> Board [style=dashed];}
